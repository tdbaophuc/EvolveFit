# Loaded automatically by src/server.ts in development (existing env vars win). Set API_SKIP_DOTENV=true to disable.
PORT=4000
# development | staging | production. staging/production run fail-closed (see apps/api/src/lib/config.ts).
APP_ENV=development
# memory = local demo only (refused when APP_ENV/NODE_ENV is production or staging). Use supabase in deployed envs.
API_DATA_MODE=memory
# Exact web origins allowed for CORS + CSRF origin checks. Required in production.
API_CORS_ORIGIN=http://localhost:3000,http://localhost:5173
# Public web app URL; used for auth email redirects and OAuth callbacks. Required (https) in production.
APP_BASE_URL=http://localhost:3000
# Extra origins allowed as auth redirectTo targets (optional, comma-separated).
AUTH_REDIRECT_ORIGINS=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=

# Session cookie encryption key (>= 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Previous secrets still accepted for decryption during rotation (comma-separated).
SESSION_SECRET_PREVIOUS=
SESSION_MAX_AGE_SECONDS=604800
# lax (default) | strict | none (none forces Secure; CSRF header check still applies)
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
# Return access/refresh tokens in auth JSON responses (only for native clients using Bearer auth).
AUTH_EXPOSE_TOKENS=false

# Reverse proxy trust for request.ip / protocol: false | true | hop count (e.g. 1) | comma-separated proxy IPs/CIDRs.
TRUST_PROXY=false
API_BODY_LIMIT_BYTES=1048576
# Serve /api/docs/openapi in production (default: hidden).
API_PUBLIC_DOCS=false

ADMIN_BOOTSTRAP_EMAILS=
GEMINI_API_KEY=
OPENAI_API_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Optional override of allowed push service hosts (comma-separated host suffixes).
PUSH_ENDPOINT_ALLOWED_HOSTS=
# >= 32 chars in production.
# Check a deployment config against Supabase (read-only): npm run verify:supabase -w @evolvefit/api -- .env.production
CRON_SECRET=
CRON_USER_ID=
CRON_USER_EMAIL=cron@evolvefit.app
